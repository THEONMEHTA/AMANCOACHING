# Public build settings only. Never put secret API keys in VITE_ variables.
# Netlify sets NETLIFY=true and URL automatically during a connected build.
# Other hosts will not process these native Netlify forms.
VITE_LEAD_CAPTURE=unconfigured
# Optional verified HTTPS calendar URL. Otherwise use the on-page request form.
VITE_BOOKING_URL=
# Optional canonical origin for builds outside Netlify.
SITE_URL=
